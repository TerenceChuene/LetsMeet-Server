generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DEACTIVATED
}

enum GlobalRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum MeetingVisibility {
  PUBLIC
  PRIVATE
}

enum MeetingStatus {
  SCHEDULED
  WAITING
  LIVE
  ENDED
  CANCELLED
  EXPIRED
}

enum ParticipantRole {
  HOST
  CO_HOST
  PARTICIPANT
}

enum ParticipantStatus {
  INVITED
  WAITING
  ADMITTED
  JOINED
  LEFT
  REMOVED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum RecordingStatus {
  STARTING
  ACTIVE
  STOPPING
  COMPLETED
  FAILED
  DELETED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique
  passwordHash     String     @map("password_hash")
  emailVerifiedAt  DateTime?  @map("email_verified_at")
  status           UserStatus @default(PENDING_VERIFICATION)
  globalRole       GlobalRole @default(USER) @map("global_role")
  lastLoginAt      DateTime?  @map("last_login_at")
  lastSeenAt       DateTime?  @map("last_seen_at")
  deletedAt        DateTime?  @map("deleted_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  profile          UserProfile?
  settings         UserSettings?
  refreshTokens    RefreshToken[]
  sessions         UserSession[]
  ownedMeetings    Meeting[]            @relation("MeetingOwner")
  participations   MeetingParticipant[]
  invitationsSent  MeetingInvitation[]  @relation("InvitationSender")
  invitationsRecv  MeetingInvitation[]  @relation("InvitationRecipient")
  chatMessages     ChatMessage[]
  notifications    Notification[]
  auditLogs        AuditLog[]           @relation("AuditActor")

  @@index([status])
  @@index([lastSeenAt])
  @@index([deletedAt])
  @@map("users")
}

model UserProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  displayName   String   @map("display_name")
  avatarUrl     String?  @map("avatar_url")
  bio           String?
  timezone      String?  @default("UTC")
  locale        String?  @default("en")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
  @@map("user_profiles")
}

model UserSettings {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @unique @map("user_id") @db.Uuid
  emailNotifications       Boolean  @default(true) @map("email_notifications")
  meetingReminders         Boolean  @default(true) @map("meeting_reminders")
  inAppNotifications       Boolean  @default(true) @map("in_app_notifications")
  defaultMuteMicrophone    Boolean  @default(false) @map("default_mute_microphone")
  defaultDisableCamera     Boolean  @default(false) @map("default_disable_camera")
  preferences              Json     @default("{}")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model RefreshToken {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  familyId        String    @map("family_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  replacedById    String?   @map("replaced_by_id") @db.Uuid
  createdByIp     String?   @map("created_by_ip")
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceId     String?   @map("device_id")
  deviceName   String?   @map("device_name")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  revokedAt    DateTime? @map("revoked_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Meeting {
  id                 String            @id @default(uuid()) @db.Uuid
  code               String            @unique
  title              String
  description        String?
  ownerId            String            @map("owner_id") @db.Uuid
  visibility         MeetingVisibility @default(PRIVATE)
  status             MeetingStatus     @default(SCHEDULED)
  passwordHash       String?           @map("password_hash")
  waitingRoomEnabled Boolean           @default(true) @map("waiting_room_enabled")
  scheduledStartAt   DateTime?         @map("scheduled_start_at")
  scheduledEndAt     DateTime?         @map("scheduled_end_at")
  startedAt          DateTime?         @map("started_at")
  endedAt            DateTime?         @map("ended_at")
  expiresAt          DateTime?         @map("expires_at")
  maxParticipants    Int?              @map("max_participants")
  livekitRoomName    String?           @unique @map("livekit_room_name")
  settings           Json              @default("{}")
  deletedAt          DateTime?         @map("deleted_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  owner        User                 @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  participants MeetingParticipant[]
  invitations  MeetingInvitation[]
  recordings   MeetingRecording[]
  messages     ChatMessage[]

  @@index([ownerId])
  @@index([status])
  @@index([scheduledStartAt])
  @@index([deletedAt])
  @@map("meetings")
}

model MeetingParticipant {
  id              String            @id @default(uuid()) @db.Uuid
  meetingId       String            @map("meeting_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  role            ParticipantRole   @default(PARTICIPANT)
  status          ParticipantStatus @default(WAITING)
  displayName     String?           @map("display_name")
  micEnabled      Boolean           @default(false) @map("mic_enabled")
  cameraEnabled   Boolean           @default(false) @map("camera_enabled")
  screenSharing   Boolean           @default(false) @map("screen_sharing")
  handRaised      Boolean           @default(false) @map("hand_raised")
  isMutedByHost   Boolean           @default(false) @map("is_muted_by_host")
  permissions     Json              @default("{}")
  livekitIdentity String?           @map("livekit_identity")
  joinedAt        DateTime?         @map("joined_at")
  leftAt          DateTime?         @map("left_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId, status])
  @@index([userId])
  @@map("meeting_participants")
}

model MeetingInvitation {
  id          String           @id @default(uuid()) @db.Uuid
  meetingId   String           @map("meeting_id") @db.Uuid
  inviterId   String           @map("inviter_id") @db.Uuid
  inviteeId   String?          @map("invitee_id") @db.Uuid
  email       String?
  status      InvitationStatus @default(PENDING)
  tokenHash   String?          @unique @map("token_hash")
  expiresAt   DateTime?        @map("expires_at")
  respondedAt DateTime?        @map("responded_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  inviter User    @relation("InvitationSender", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User?   @relation("InvitationRecipient", fields: [inviteeId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([inviteeId])
  @@index([email])
  @@map("meeting_invitations")
}

model MeetingRecording {
  id            String          @id @default(uuid()) @db.Uuid
  meetingId     String          @map("meeting_id") @db.Uuid
  status        RecordingStatus @default(STARTING)
  egressId      String?         @map("egress_id")
  storageKey    String?         @map("storage_key")
  storageUrl    String?         @map("storage_url")
  mimeType      String?         @map("mime_type")
  sizeBytes     BigInt?         @map("size_bytes")
  durationSec   Int?            @map("duration_sec")
  startedAt     DateTime?       @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  expiresAt     DateTime?       @map("expires_at")
  metadata      Json            @default("{}")
  deletedAt     DateTime?       @map("deleted_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([status])
  @@index([deletedAt])
  @@map("meeting_recordings")
}

model ChatMessage {
  id              String    @id @default(uuid()) @db.Uuid
  meetingId       String    @map("meeting_id") @db.Uuid
  senderId        String    @map("sender_id") @db.Uuid
  body            String
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  deletedById     String?   @map("deleted_by_id") @db.Uuid
  attachmentMeta  Json?     @map("attachment_meta")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel @default(IN_APP)
  type      String
  title     String
  body      String
  status    NotificationStatus  @default(PENDING)
  payload   Json                @default("{}")
  readAt    DateTime?           @map("read_at")
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
