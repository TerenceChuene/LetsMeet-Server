# Application
NODE_ENV=development
PORT=3000
APP_NAME=letsmeet-server
APP_URL=http://localhost:3000
LOG_LEVEL=info

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:4200,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# PostgreSQL
DATABASE_URL=postgresql://letsmeet:letsmeet@localhost:5432/letsmeet?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (required — use long random secrets in every environment)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# LiveKit (required in production)
# LIVEKIT_URL is the WebSocket URL clients use for media (never route A/V via Express).
LIVEKIT_URL=ws://localhost:7880
# Optional override for RoomService HTTP host (defaults: ws→http, wss→https)
LIVEKIT_API_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Azure Blob Storage (Azurite locally via docker compose)
# Well-known Azurite account — replace with a real storage account for LiveKit egress.
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
AZURE_STORAGE_CONTAINER=letsmeet-recordings
# Required for Azurite; omit (or leave empty) when using real Azure.
AZURE_STORAGE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
RECORDING_RETENTION_DAYS=30
RECORDING_DOWNLOAD_TTL_SECONDS=3600

# Email (optional — logs to console when SMTP_HOST unset)
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@letsmeet.local
